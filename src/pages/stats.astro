---
// Private traffic page (DEC-29). Shows how many people reached the site and
// how many pressed Buy now, read from the checkout worker's KV counters.
//
// Standalone by design, like /hello (DEC-23): not linked from the site, not
// in the sitemap, noindex, and English-only — the bilingual rule covers what
// customers read, and nobody but the author opens this.
//
// "Hidden" is not "private": anyone who guesses the URL gets this shell. The
// protection is the key, which lives on the worker — without it the page has
// nothing to show. The key is kept in localStorage so the URL can be cleaned
// after first use rather than sitting in history and referrers.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { getEntry } from 'astro:content';

const settings = (await getEntry('site', 'settings'))!.data;
const endpoint = (settings.checkoutEndpoint || '').replace(/\/+$/, '');
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Traffic — Tali</title>
    <meta name="description" content="Private traffic figures for tali.my." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <main class="stats" data-endpoint={endpoint}>
      <header class="stats__head">
        <img class="stats__logo" src="/images/tali-logo.png" alt="Tali" height="26" />
        <span class="stats__eyebrow">Traffic</span>
      </header>

      {/* Shown until a key is stored; also where a rejected key sends you back. */}
      <form class="stats__gate" hidden>
        <label class="stats__gate-label" for="stats-key">Access key</label>
        <input
          class="stats__gate-input"
          id="stats-key"
          type="password"
          autocomplete="off"
          spellcheck="false"
          placeholder="paste the key"
        />
        <button class="btn" type="submit">Show figures</button>
        <p class="stats__gate-error" role="alert" hidden></p>
      </form>

      <div class="stats__body" hidden>
        <div class="stats__tiles">
          <div class="stats__tile">
            <span class="stats__tile-label">Page views</span>
            <span class="stats__tile-value" data-tile="views">—</span>
            <span class="stats__tile-note" data-tile="since"></span>
          </div>
          <div class="stats__tile">
            <span class="stats__tile-label">Buy now pressed</span>
            <span class="stats__tile-value" data-tile="clicks">—</span>
            <span class="stats__tile-note" data-tile="rate"></span>
          </div>
          <div class="stats__tile">
            <span class="stats__tile-label">Orders</span>
            <span class="stats__tile-value" data-tile="orders">—</span>
            <span class="stats__tile-note">all-time, from the order ledger</span>
          </div>
        </div>

        <div class="stats__range" role="group" aria-label="Time range">
          <button type="button" data-days="7">7 days</button>
          <button type="button" data-days="14" aria-pressed="true">14 days</button>
          <button type="button" data-days="30">30 days</button>
          <button type="button" data-days="90">90 days</button>
        </div>

        <section class="chart" data-series="views">
          <h2 class="chart__title">Page views per day</h2>
          <div class="chart__plot"></div>
          <div class="chart__axis"></div>
        </section>

        <section class="chart" data-series="clicks">
          <h2 class="chart__title">Buy now presses per day</h2>
          <div class="chart__plot"></div>
          <div class="chart__axis"></div>
        </section>

        <details class="stats__notes">
          <summary>What these numbers count</summary>
          <p>
            <strong>Page views</strong> are loads that ran JavaScript and reached the
            checkout worker. Crawlers that don't execute scripts never register, and
            reloads within 30 seconds fold into one — so this is a floor on real
            traffic, not a ceiling.
          </p>
          <p>
            <strong>Buy now pressed</strong> counts every press of the hero button,
            the nav pill or the plan card — they all open the same checkout modal. A
            press counts even if checkout then fails, because the intent was real.
          </p>
          <p>
            <strong>Orders</strong> is the all-time claimed count from the order
            ledger, the same figure the sales cap uses. It is not restricted to the
            window above, and it may include orders placed before counting began —
            so don't read it as a conversion of the views shown here.
          </p>
          <p>
            Every visit is recorded as its own entry rather than added to a running
            total, so simultaneous visitors all get counted. Figures can lag about a
            minute behind on a refresh — they settle on their own.
          </p>
        </details>

        <button class="stats__forget" type="button">Forget key on this device</button>
      </div>

      <p class="stats__error" role="alert" hidden></p>
    </main>

    <div class="tip" hidden></div>

    <script>
      const main = document.querySelector('.stats');
      const endpoint = main.dataset.endpoint;
      const gate = document.querySelector('.stats__gate');
      const gateError = document.querySelector('.stats__gate-error');
      const body = document.querySelector('.stats__body');
      const error = document.querySelector('.stats__error');
      const tip = document.querySelector('.tip');
      const STORE = 'tali-stats-key';

      let days = 14;

      const store = {
        get() {
          try {
            return localStorage.getItem(STORE);
          } catch (e) {
            return null;
          }
        },
        set(v) {
          try {
            localStorage.setItem(STORE, v);
          } catch (e) {}
        },
        clear() {
          try {
            localStorage.removeItem(STORE);
          } catch (e) {}
        },
      };

      // A key in the URL is spent immediately: saved, then wiped from the bar
      // so it doesn't linger in history or get shoulder-read.
      const params = new URLSearchParams(location.search);
      const fromUrl = params.get('key');
      if (fromUrl) {
        store.set(fromUrl);
        history.replaceState(null, '', location.pathname);
      }

      const nf = new Intl.NumberFormat('en-US');
      const dayLabel = (iso, long) =>
        new Intl.DateTimeFormat('en-GB', {
          timeZone: 'UTC',
          day: 'numeric',
          month: 'short',
          ...(long ? { weekday: 'short' } : {}),
        }).format(new Date(`${iso}T12:00:00Z`));

      function showGate(message) {
        gate.hidden = false;
        body.hidden = true;
        gateError.hidden = !message;
        gateError.textContent = message || '';
        gate.querySelector('input').focus();
      }

      /**
       * One single-series bar chart. Views and presses live on wildly
       * different scales, so each gets its own chart and its own axis —
       * never two scales in one frame.
       */
      function draw(section, rows, field, noun) {
        const plot = section.querySelector('.chart__plot');
        const axis = section.querySelector('.chart__axis');
        const peak = Math.max(1, ...rows.map((r) => r[field]));
        plot.innerHTML = '';
        rows.forEach((r) => {
          const n = r[field];
          const bar = document.createElement('div');
          bar.className = 'chart__bar';
          // A zero day still gets a hairline, so gaps read as measured
          // rather than missing.
          bar.style.setProperty('--h', n ? `${(n / peak) * 100}%` : '2px');
          if (!n) bar.dataset.empty = 'true';
          bar.tabIndex = 0;
          bar.dataset.tip = `${dayLabel(r.date, true)} · ${nf.format(n)} ${noun}`;
          if (n === peak && n > 0) {
            const label = document.createElement('span');
            label.className = 'chart__peak';
            label.textContent = nf.format(n);
            bar.appendChild(label);
          }
          plot.appendChild(bar);
        });
        axis.innerHTML = '';
        const first = document.createElement('span');
        first.textContent = dayLabel(rows[0].date);
        const last = document.createElement('span');
        last.textContent = dayLabel(rows[rows.length - 1].date);
        axis.append(first, last);
      }

      function render(data) {
        const rate = data.total.views
          ? `${((data.total.clicks / data.total.views) * 100).toFixed(1)}% of views`
          : '';
        const set = (name, text) => {
          const el = document.querySelector(`[data-tile="${name}"]`);
          if (el) el.textContent = text;
        };
        set('views', nf.format(data.total.views));
        set('clicks', nf.format(data.total.clicks));
        set('orders', data.orders === null ? '—' : nf.format(data.orders));
        set('rate', rate);
        set(
          'since',
          [
            data.since ? `since ${dayLabel(data.since)}` : 'no data yet',
            data.capped ? '· capped at 10,000/day' : '',
          ]
            .filter(Boolean)
            .join(' ')
        );

        draw(document.querySelector('[data-series="views"]'), data.days, 'views', 'views');
        draw(document.querySelector('[data-series="clicks"]'), data.days, 'clicks', 'presses');

        gate.hidden = true;
        body.hidden = false;
        error.hidden = true;
      }

      async function load() {
        const key = store.get();
        if (!key) return showGate('');
        if (!endpoint) {
          error.hidden = false;
          error.textContent = 'No checkout endpoint is configured, so there is nothing to read.';
          return;
        }
        try {
          const res = await fetch(
            `${endpoint}/stats?key=${encodeURIComponent(key)}&days=${days}`
          );
          if (res.status === 401) {
            store.clear();
            return showGate('That key was rejected.');
          }
          if (!res.ok) throw new Error(`worker returned ${res.status}`);
          render(await res.json());
        } catch (err) {
          error.hidden = false;
          error.textContent = `Couldn't reach the worker: ${err.message}`;
        }
      }

      gate.addEventListener('submit', (e) => {
        e.preventDefault();
        const value = gate.querySelector('input').value.trim();
        if (!value) return;
        store.set(value);
        gate.querySelector('input').value = '';
        load();
      });

      document.querySelector('.stats__forget').addEventListener('click', () => {
        store.clear();
        showGate('Key forgotten.');
      });

      document.querySelectorAll('.stats__range button').forEach((b) => {
        b.addEventListener('click', () => {
          days = Number(b.dataset.days);
          document
            .querySelectorAll('.stats__range button')
            .forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
          load();
        });
      });

      // One tooltip for both charts — bars are small, so the hit target is the
      // bar's whole column and the tip follows the pointer.
      const showTip = (el) => {
        tip.textContent = el.dataset.tip;
        tip.hidden = false;
        const r = el.getBoundingClientRect();
        const t = tip.getBoundingClientRect();
        const x = r.left + r.width / 2 - t.width / 2;
        tip.style.left = `${Math.max(8, Math.min(x, window.innerWidth - t.width - 8))}px`;
        tip.style.top = `${r.top + window.scrollY - t.height - 8}px`;
      };
      const hideTip = () => {
        tip.hidden = true;
      };
      document.addEventListener('pointerover', (e) => {
        const bar = e.target.closest?.('.chart__bar');
        if (bar) showTip(bar);
      });
      document.addEventListener('pointerout', (e) => {
        if (e.target.closest?.('.chart__bar')) hideTip();
      });
      document.addEventListener('focusin', (e) => {
        const bar = e.target.closest?.('.chart__bar');
        if (bar) showTip(bar);
      });
      document.addEventListener('focusout', hideTip);

      load();
    </script>

    <style>
      .stats {
        max-width: 54rem;
        margin: 0 auto;
        padding: clamp(2rem, 6vw, 4rem) var(--gutter) 5rem;
      }
      .stats__head {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-bottom: 2.5rem;
      }
      .stats__logo {
        height: 26px;
        width: auto;
      }
      .stats__eyebrow {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-dim);
        padding-left: 0.9rem;
        border-left: 1px solid var(--line);
      }

      .stats__gate {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 0.75rem;
        max-width: 26rem;
      }
      .stats__gate-label {
        flex: 1 0 100%;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-dim);
      }
      .stats__gate-input {
        flex: 1 1 12rem;
        padding: 0.7rem 0.85rem;
        font: inherit;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 8px;
      }
      .stats__gate-input:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
      }
      .stats__gate-error,
      .stats__error {
        flex: 1 0 100%;
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-dim);
      }

      .stats__tiles {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
      }
      .stats__tile {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 1.25rem 1.25rem 1.4rem;
        background: var(--surface);
      }
      .stats__tile-label {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-dim);
      }
      .stats__tile-value {
        font-family: var(--display);
        font-size: clamp(1.9rem, 5vw, 2.6rem);
        line-height: 1;
        color: var(--text);
        font-variant-numeric: tabular-nums;
      }
      .stats__tile-note {
        font-size: 0.78rem;
        color: var(--text-dim);
        min-height: 1.2em;
      }

      .stats__range {
        display: flex;
        gap: 0.4rem;
        margin: 2.25rem 0 0.5rem;
      }
      .stats__range button {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        color: var(--text-dim);
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        cursor: pointer;
      }
      .stats__range button[aria-pressed='true'] {
        color: var(--on-accent);
        background: var(--accent);
        border-color: var(--accent);
      }

      .chart {
        margin-top: 2rem;
      }
      .chart__title {
        font-family: var(--sans);
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text);
        margin: 0 0 0.9rem;
      }
      .chart__plot {
        display: flex;
        align-items: flex-end;
        gap: 2px; /* the surface gap that keeps adjacent bars distinct */
        height: 7.5rem;
        padding-top: 1.1rem; /* room for the peak label */
        border-bottom: 1px solid var(--line);
      }
      .chart__bar {
        position: relative;
        flex: 1 1 0;
        height: var(--h);
        min-width: 3px;
        background: var(--accent);
        border-radius: 4px 4px 0 0; /* rounded data-end, square on the baseline */
        cursor: default;
      }
      .chart__bar[data-empty] {
        background: var(--line);
      }
      .chart__bar:hover,
      .chart__bar:focus-visible {
        background: var(--text);
        outline: none;
      }
      .chart__peak {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-bottom: 0.3rem;
        font-family: var(--mono);
        font-size: 0.68rem;
        color: var(--text-dim); /* values wear ink, never the series color */
      }
      .chart__axis {
        display: flex;
        justify-content: space-between;
        margin-top: 0.45rem;
        font-family: var(--mono);
        font-size: 0.68rem;
        color: var(--text-dim);
      }

      .tip {
        position: absolute;
        z-index: 10;
        padding: 0.4rem 0.6rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        white-space: nowrap;
        color: var(--on-accent);
        background: var(--text);
        border-radius: 6px;
        pointer-events: none;
      }

      .stats__notes {
        margin-top: 3rem;
        font-size: 0.85rem;
        color: var(--text-dim);
      }
      .stats__notes summary {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
      }
      .stats__notes p {
        margin: 0.9rem 0 0;
        max-width: 46ch;
        line-height: 1.6;
      }
      .stats__notes strong {
        color: var(--text);
        font-weight: 500;
      }

      .stats__forget {
        margin-top: 2.5rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--text-dim);
        background: none;
        border: 0;
        padding: 0;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }
    </style>
  </body>
</html>
