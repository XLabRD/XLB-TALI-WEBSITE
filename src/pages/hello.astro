---
// Device-onboarding landing page (DEC-23). The QR code on every Tali screen
// points here: https://tali.my/hello
// Standalone by design — not linked from the main site, excluded from the
// sitemap, and noindex. Self-contained head (no Base.astro) because the
// bilingual hreflang machinery doesn't apply to this single page.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getEntry } from 'astro:content';

const settings = (await getEntry('site', 'settings'))!.data;
// Badge stays inert until an app link is set in Keystatic.
const appUrl = settings.appStoreUrl || '#';
const appReady = Boolean(settings.appStoreUrl);
// TestFlight links say "Download Beta"; a public App Store link drops it.
const isBeta = appUrl.includes('testflight.apple.com');
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hello! — Tali</title>
    <meta name="description" content="Welcome to Tali. Download the app to set up your device." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <main class="hello">
      <img class="hello__logo" src="/images/tali-logo.png" alt="Tali" height="34" />
      <h1 class="hello__title">Hello!</h1>
      <p class="hello__text">
        Welcome to Tali. Your collection's new keeper. To get started, let's
        download the app. It only takes a few minutes.
      </p>
      <div class="hello__actions">
        <a
          class="hello__store"
          href={appUrl}
          aria-disabled={appReady ? undefined : 'true'}
        >
          <svg viewBox="0 0 384 512" width="28" height="28" aria-hidden="true" fill="currentColor">
            <path
              d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"
            ></path>
          </svg>
          <span>
            <small>{isBeta ? 'Download Beta on the' : 'Download on the'}</small>
            App Store
          </span>
        </a>
        <p class="hello__platform">Android app coming soon.</p>
        <a class="hello__help" href={`mailto:${settings.contactEmail}?subject=Tali%20help`}>
          Get help
        </a>
      </div>
      <a class="hello__site" href="/">tali.my</a>
    </main>
    {
      appReady && (
        <script is:inline define:vars={{ appUrl }}>
          // iOS visitors go straight to the app link; everyone else sees the
          // page. iPadOS 13+ masquerades as macOS, hence the touch check.
          const ios =
            /iP(hone|od|ad)/.test(navigator.userAgent) ||
            (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
          if (ios) location.replace(appUrl);
        </script>
      )
    }
  </body>
</html>

<style>
  .hello {
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: 2rem 1.5rem 3rem;
    background: radial-gradient(
      50rem 30rem at 50% -10%,
      color-mix(in srgb, var(--accent) 10%, var(--bg)),
      var(--bg)
    );
  }
  .hello__logo {
    height: 34px;
    width: auto;
    margin-bottom: 1.2rem;
  }
  .hello__title {
    font-family: var(--display);
    font-size: clamp(4rem, 16vw, 7.5rem);
    line-height: 1;
    color: var(--text);
  }
  .hello__text {
    max-width: 26rem;
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .hello__actions {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    margin-top: 1.4rem;
  }
  .hello__store {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    border-radius: 12px;
    padding: 0.7rem 1.4rem 0.75rem;
    transition: transform 0.15s ease;
  }
  .hello__store:hover {
    transform: scale(1.03);
  }
  .hello__store span {
    display: grid;
    text-align: left;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.15;
  }
  .hello__store small {
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .hello__platform {
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .hello__help {
    margin-top: 0.8rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.55rem 1.3rem;
    transition: border-color 0.15s ease;
  }
  .hello__help:hover {
    border-color: var(--accent);
  }
  .hello__site {
    margin-top: 2.2rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .hello__site:hover {
    color: var(--accent);
  }
</style>
