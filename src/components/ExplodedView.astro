---
// Scroll-driven exploded view of the Tali device (DEC-22).
// Pre-rendered WebP frames (Blender, from the Fusion 360 model) scrubbed on a
// <canvas> as the section scrolls — no runtime 3D, no dependencies. Feature
// callouts fade in when the explosion completes; label text comes from
// home.json (explodeCallouts), anchor geometry lives here in frame
// coordinates (1080×1080, matched to frame_079).
interface Props {
  copy: Record<string, any>;
}
const { copy } = Astro.props;

const FRAME_COUNT = 80;
const framePath = (i: number) => `/images/explode/tali/frame_${String(i).padStart(3, '0')}.webp`;
const lastFrame = framePath(FRAME_COUNT - 1);

const SIZE = 1080;
// key → callout label in copy.explodeCallouts; a/l = anchor/label positions.
const CALLOUTS: { key: string; ax: number; ay: number; lx: number; ly: number; side: 'left' | 'right' }[] = [
  { key: 'lightSensor', ax: 248, ay: 40, lx: 330, ly: 40, side: 'left' },
  { key: 'ambientSensor', ax: 130, ay: 128, lx: 60, ly: 190, side: 'left' },
  { key: 'epaperScreen', ax: 880, ay: 300, lx: 1020, ly: 250, side: 'right' },
  { key: 'battery', ax: 470, ay: 748, lx: 48, ly: 700, side: 'left' },
  { key: 'accelerometer', ax: 223, ay: 736, lx: 56, ly: 830, side: 'left' },
  { key: 'usbC', ax: 898, ay: 750, lx: 1035, ly: 830, side: 'right' },
  { key: 'accessoriesPort', ax: 772, ay: 890, lx: 1035, ly: 985, side: 'right' },
];
const pct = (v: number) => `${(v / SIZE) * 100}%`;
const callouts = copy.explodeCallouts
  ? CALLOUTS.map((c) => ({ ...c, label: copy.explodeCallouts[c.key] })).filter((c) => c.label)
  : [];
---

<section class="section explode" id="inside">
  <div class="explode__track" data-frames={FRAME_COUNT} data-path={framePath(0)}>
    <div class="explode__sticky">
      <div class="wrap">
        <div class="section__head head--center">
          <p class="kicker">{copy.explodeKicker}</p>
          <h2 class="section__title">{copy.explodeTitle}</h2>
          <p class="caption">{copy.explodeCaption}</p>
        </div>
        <div class="explode__stage">
          <canvas class="explode__canvas" width={SIZE} height={SIZE} aria-hidden="true"></canvas>
          <img class="explode__fallback" src={lastFrame} alt={copy.explodeTitle} width={SIZE} height={SIZE} loading="lazy" />
          {
            callouts.length > 0 && (
              <div class="explode__callouts" aria-hidden="false">
                <svg class="explode__lines" viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
                  {callouts.map((c) => (
                    <>
                      <line x1={c.ax} y1={c.ay} x2={c.lx} y2={c.ly} />
                      <circle class="ring" cx={c.ax} cy={c.ay} r="8" />
                      <circle class="core" cx={c.ax} cy={c.ay} r="3" />
                    </>
                  ))}
                </svg>
                {callouts.map((c) => (
                  <span class={`explode__label explode__label--${c.side}`} style={`left:${pct(c.lx)};top:${pct(c.ly)}`}>
                    {c.label}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('.explode__track');
  const canvas = document.querySelector<HTMLCanvasElement>('.explode__canvas');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (track && canvas && !reduced) {
    track.classList.add('is-scrub');
    const ctx = canvas.getContext('2d')!;
    const count = Number(track.dataset.frames);
    const tpl = track.dataset.path!;
    const src = (i: number) => tpl.replace('000', String(i).padStart(3, '0'));

    const frames: (HTMLImageElement | null)[] = Array(count).fill(null);
    let loaded = false;
    const preload = () => {
      if (loaded) return;
      loaded = true;
      for (let i = 0; i < count; i++) {
        const img = new Image();
        img.src = src(i);
        img.decode?.().catch(() => {});
        frames[i] = img;
      }
      frames[0]!.addEventListener('load', onScroll);
    };

    let current = -1;
    const draw = (i: number) => {
      const img = frames[i];
      if (!img || !img.complete) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      current = i;
    };

    // the explosion completes at HOLD_AT of the track; the remaining scroll
    // is a hold on the final frame so fast scrollers still see the callouts
    const HOLD_AT = 0.78;
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = track.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = Math.min(1, Math.max(0, -rect.top / scrollable));
      const eased = Math.min(1, progress / HOLD_AT);
      const i = Math.min(count - 1, Math.round(eased * (count - 1)));
      track.classList.toggle('is-done', i >= count - 2);
      if (i !== current) draw(i);
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) preload();
      },
      { rootMargin: '100% 0px' }
    ).observe(track);

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    if (track.getBoundingClientRect().top < window.innerHeight * 2) preload();
  }
</script>

<style>
  .explode {
    padding-block: 0;
  }
  .explode__track {
    /* tall track = scrub distance; sticky inner viewport */
    height: 400vh;
  }
  .explode__sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: grid;
    align-content: center;
    padding-block: 3.5rem 2rem;
  }
  .head--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
  .caption {
    color: var(--text-dim);
    max-width: 38rem;
  }
  .explode__stage {
    position: relative;
    width: min(34rem, 88vw);
    margin-inline: auto;
  }
  .explode__canvas,
  .explode__fallback {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
  .explode__canvas {
    display: none;
  }
  .explode__track.is-scrub .explode__canvas {
    display: block;
  }
  .explode__track.is-scrub .explode__fallback {
    display: none;
  }

  /* ---- callouts ---- */
  .explode__callouts {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .explode__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .explode__lines line {
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  .explode__lines .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
  }
  .explode__lines .core {
    fill: var(--accent);
  }
  .explode__label {
    position: absolute;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: clamp(0.62rem, 2.4vw, 0.82rem);
    line-height: 1;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.45em 0.9em;
  }
  .explode__label--right {
    transform: translate(-100%, -50%);
  }
  /* scrub mode: hidden until the explosion completes */
  .explode__track.is-scrub .explode__callouts {
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .explode__track.is-scrub.is-done .explode__callouts {
    opacity: 1;
  }

  /* reduced motion / no JS: plain section height, static exploded image with
     callouts always visible */
  .explode__track:not(.is-scrub) {
    height: auto;
  }
  .explode__track:not(.is-scrub) .explode__sticky {
    position: static;
    min-height: 0;
  }
</style>
