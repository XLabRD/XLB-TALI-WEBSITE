---
import SystemLink from './SystemLink.astro';

interface Props {
  copy: Record<string, any>;
}
const { copy } = Astro.props;
---

<section class="section" id="system">
  <div class="wrap">
    <div class="system__top">
      <div class="section__head system__copy">
        <p class="kicker">{copy.systemKicker}</p>
        <h2 class="section__title">{copy.systemTitle}</h2>
        <p class="intro">{copy.systemIntro}</p>
      </div>
      <SystemLink copy={copy} />
    </div>
    <div class="parts">
      {
        copy.systemParts.map((part: any, i: number) => (
          <article class="part">
            {part.image ? (
              <img
                class="part__img"
                src={part.image}
                alt={part.imageAlt}
                width="1600"
                height="900"
                loading="lazy"
              />
            ) : (
              <div class="part__icon" aria-hidden="true">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="7" y="2.5" width="10" height="19" rx="2.5" />
                  <line x1="10.5" y1="18.5" x2="13.5" y2="18.5" />
                </svg>
              </div>
            )}
            <span class="part__index">0{i + 1}</span>
            <h3 class="part__name">{part.name}</h3>
            <p class="part__role">{part.role}</p>
            <p class="part__body">{part.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Copy left, the wireless link shown on the right; stacks under the copy on
     narrow screens, where the illustration goes first to break up the text. */
  .system__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    margin-bottom: clamp(2.25rem, 5vw, 3.5rem);
  }
  .system__copy {
    margin-bottom: 0;
    max-width: 36em;
  }
  .intro {
    color: var(--text-dim);
    /* blank lines in the copy become paragraph breaks */
    white-space: pre-line;
  }
  .parts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .part {
    background: var(--surface);
    padding: 2rem 1.75rem 2.25rem;
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }
  .part__img,
  .part__icon {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    margin-bottom: 0.9rem;
  }
  .part__img {
    display: block;
    height: auto;
  }
  .part__icon {
    display: grid;
    place-items: center;
    background: var(--surface-2);
    color: var(--accent);
  }
  .part__index {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .part__name {
    font-size: 1.5rem;
  }
  .part__role {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .part__body {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 860px) {
    .system__top {
      grid-template-columns: 1fr;
    }
    .parts {
      grid-template-columns: 1fr;
    }
  }
</style>
