---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import System from './System.astro';
import ExplodedView from './ExplodedView.astro';
import AppShowcase from './AppShowcase.astro';
import Features from './Features.astro';
import Film from './Film.astro';
import Pricing from './Pricing.astro';
import ShipSchedule from './ShipSchedule.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';

interface Props {
  locale: 'en' | 'es';
}
const { locale } = Astro.props;
const homePath = locale === 'en' ? '/' : '/es/';
const altPath = locale === 'en' ? '/es/' : '/';

const settings = (await getEntry('site', 'settings'))!.data;
const home = (await getEntry('home', 'home'))!.data[locale];
const ui = (await getEntry('ui', 'ui'))!.data[locale];

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

const features = (await getCollection('features'))
  .sort(byOrder)
  .map((f) => ({ icon: f.data.icon, comingSoon: f.data.comingSoon, ...f.data[locale] }));
const faqs = (await getCollection('faq'))
  .sort(byOrder)
  .map((f) => ({ preorder: f.data.preorder, linkHref: f.data.linkHref, ...f.data[locale] }));
const plans = (await getCollection('plans'))
  .sort(byOrder)
  .map((p) => ({ featured: p.data.featured, price: p.data.price, ...p.data[locale] }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Tali',
  description: ui.metaDescription,
  brand: { '@type': 'Brand', name: settings.siteName },
  url: new URL(homePath, Astro.site).href,
};
---

<Base locale={locale} title={ui.metaTitle} description={ui.metaDescription} altPath={altPath}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Header locale={locale} ui={ui} altPath={altPath} homePath={homePath} />
  <main>
    <Hero locale={locale} copy={home} />
    <System copy={home} />
    <ExplodedView copy={home} />
    <AppShowcase copy={home} />
    <Features locale={locale} copy={home} features={features} soonLabel={ui.featureSoon} />
    <Film copy={home} />
    <Pricing locale={locale} copy={home} ui={ui} plans={plans} settings={settings} />
    <ShipSchedule copy={home} />
    <Faq copy={home} items={faqs} ctaLabel={ui.navPreorder} />
    <Contact copy={home} ui={ui} settings={settings} />
  </main>
  <Footer ui={ui} settings={settings} />
  <script>
    // Long-distance anchor clicks jump instantly instead of smooth-scrolling
    // through the tall exploded-view track (where the glide is slow and any
    // wheel input cancels it, stranding the user mid-animation). Short hops
    // keep the global smooth behavior. #contact is excluded — it opens the
    // contact dialog.
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]:not([href="#contact"])').forEach((a) =>
      a.addEventListener('click', (e) => {
        const target = document.getElementById(a.getAttribute('href')!.slice(1));
        if (!target) return;
        if (Math.abs(target.getBoundingClientRect().top) > window.innerHeight * 2.5) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'instant', block: 'start' });
          history.pushState(null, '', a.getAttribute('href'));
        }
      })
    );
  </script>
</Base>
