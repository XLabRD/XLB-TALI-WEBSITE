---
interface Props {
  copy: Record<string, any>;
  items: Array<{
    question: string;
    answer: string;
    tiers?: Array<{ name: string; tagline: string; items: string[] }>;
    preorder?: boolean;
    linkHref?: string;
    linkText?: string;
  }>;
  /** Label for the pre-order button on entries flagged `preorder`. */
  ctaLabel?: string;
}
const { copy, items, ctaLabel } = Astro.props;
---

<section class="section" id="faq">
  <div class="wrap">
    <div class="section__head">
      <p class="kicker">{copy.faqKicker}</p>
      <h2 class="section__title">{copy.faqTitle}</h2>
    </div>
    <div class="list">
      {
        items.map((item) => (
          <details class="item">
            <summary>{item.question}</summary>
            {item.answer && <p>{item.answer}</p>}
            {(item.tiers?.length ?? 0) > 0 && (
              <div class="tiers">
                {item.tiers!.map((tier) => (
                  <div class="tier">
                    <p class="tier__name">{tier.name}</p>
                    <p class="tier__tagline">{tier.tagline}</p>
                    <ul class="tier__list">
                      {tier.items.map((entry) => (
                        <li>{entry}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
            {item.linkHref && item.linkText && (
              <p class="item__link">
                <a href={item.linkHref}>{item.linkText}</a>
              </p>
            )}
            {item.preorder && ctaLabel && (
              <p class="item__cta">
                {/* data-preorder opens the embedded checkout (Pricing.astro);
                    without JS the anchor falls back to the edition card. */}
                <a class="btn" href="#edition" data-preorder>
                  {ctaLabel}
                </a>
              </p>
            )}
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .list {
    max-width: 46rem;
    border-top: 1px solid var(--line);
  }
  .item {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 1.15rem 2.2rem 1.15rem 0;
    font-family: var(--display);
    font-size: 1.1rem;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1.1rem;
    transition: transform 0.15s ease;
  }
  details[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }
  .item p {
    color: var(--text-dim);
    font-size: 0.95rem;
    padding: 0 0 1.3rem;
    max-width: 40em;
    /* blank lines in the stored answer become paragraph breaks */
    white-space: pre-line;
  }
  .tiers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 0 0 1.3rem;
  }
  .tier {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
    background: linear-gradient(170deg, var(--surface), transparent 80%);
  }
  .tier__name {
    font-family: var(--display);
    font-size: 1.05rem;
    color: var(--text);
    padding: 0 0 0.15rem;
  }
  .tier__tagline {
    color: var(--text-dim);
    font-size: 0.85rem;
    padding: 0 0 0.7rem;
  }
  .tier__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .tier__list li {
    font-size: 0.9rem;
    color: var(--text-dim);
    padding-left: 1.1rem;
    position: relative;
  }
  .tier__list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .item__cta {
    padding: 0 0 1.3rem;
  }
  .item__link {
    padding: 0 0 1.3rem;
    font-size: 0.92rem;
  }
  .item__link a {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .tiers {
      grid-template-columns: 1fr;
    }
  }
</style>
