---
interface Props {
  copy: Record<string, any>;
  ui: Record<string, string>;
  settings: { contactEmail: string; formEndpoint: string };
}
const { copy, ui, settings } = Astro.props;
// TODO(DEC-11): formEndpoint is empty until the form backend is created.
// Two accepted formats:
//   - a full POST URL (Formspree-style) — posted to as-is, no captcha widget
//   - a bare Web3Forms access key — posts to api.web3forms.com with their
//     built-in hCaptcha (verified server-side by Web3Forms)
// Empty → the form falls back to mailto.
const raw = settings.formEndpoint;
const isW3F = Boolean(raw) && !raw.startsWith('http');
const endpoint = isW3F ? 'https://api.web3forms.com/submit' : raw;
---

<section class="section" id="contact">
  <div class="wrap contact">
    <div class="section__head contact__head">
      <p class="kicker">{copy.contactKicker}</p>
      <h2 class="section__title">{copy.contactTitle}</h2>
      <p class="contact__intro">{copy.contactIntro}</p>
      <button class="btn contact__open" type="button">{ui.formSend}</button>
      <noscript>
        <p class="contact__intro">
          <a href={`mailto:${settings.contactEmail}`}>{ui.formMailto}</a>
        </p>
      </noscript>
    </div>
  </div>
</section>

<dialog class="contact-dialog" aria-labelledby="contact-dialog-title">
  <button class="contact-dialog__close" type="button" aria-label="Close">✕</button>
  <h2 class="contact-dialog__title" id="contact-dialog-title">{copy.contactTitle}</h2>
  <p class="contact-dialog__intro">{copy.contactIntro}</p>
  <form
    id="contact-form"
    class="form"
    action={endpoint || `mailto:${settings.contactEmail}`}
    method="POST"
    data-endpoint={endpoint}
    data-captcha={isW3F ? 'true' : undefined}
    novalidate
  >
    {isW3F && <input type="hidden" name="access_key" value={raw} />}
    {/* Web3Forms' native honeypot — their server drops submissions that fill it */}
    {isW3F && <input class="hp" type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" />}
    <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label>
      <span>{ui.formName}</span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label>
      <span>{ui.formEmail}</span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label>
      <span>{ui.formMessage}</span>
      <textarea name="message" rows="5" required></textarea>
    </label>
    {isW3F && <div class="h-captcha" data-captcha="true"></div>}
    <button class="btn" type="submit" data-label={ui.formSend} data-sending={ui.formSending}>
      {ui.formSend}
    </button>
    <p class="form__status form__status--ok" hidden>{ui.formSuccess}</p>
    <p class="form__status form__status--err" hidden>
      {ui.formError}
      <a href={`mailto:${settings.contactEmail}`}>{ui.formMailto}</a>
    </p>
  </form>
</dialog>

<script>
  const dialog = document.querySelector('.contact-dialog') as HTMLDialogElement;
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const ok = form.querySelector('.form__status--ok') as HTMLElement;
  const err = form.querySelector('.form__status--err') as HTMLElement;
  const endpoint = form.dataset.endpoint;
  const wantsCaptcha = form.dataset.captcha === 'true';
  let captchaLoaded = false;

  const open = () => {
    dialog.showModal();
    // load the captcha script only when someone actually opens the form
    if (wantsCaptcha && !captchaLoaded) {
      captchaLoaded = true;
      const s = document.createElement('script');
      s.src = 'https://web3forms.com/client/script.js';
      s.async = true;
      s.defer = true;
      document.head.appendChild(s);
    }
  };

  // any link pointing at #contact opens the dialog instead of scrolling
  document.querySelectorAll<HTMLAnchorElement>('a[href="#contact"]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      open();
    })
  );
  document.querySelector('.contact__open')?.addEventListener('click', open);
  dialog.querySelector('.contact-dialog__close')?.addEventListener('click', () => dialog.close());
  // click on the backdrop closes
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  form.addEventListener('submit', async (event) => {
    if (!endpoint) return; // no endpoint yet — let the mailto action handle it
    event.preventDefault();
    ok.hidden = true;
    err.hidden = true;
    button.disabled = true;
    button.textContent = button.dataset.sending!;
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      (window as any).hcaptcha?.reset();
      ok.hidden = false;
    } catch {
      err.hidden = false;
    } finally {
      button.disabled = false;
      button.textContent = button.dataset.label!;
    }
  });
</script>

<style>
  .contact {
    display: grid;
  }
  .contact__head {
    margin-bottom: 0;
  }
  .contact__intro {
    color: var(--text-dim);
  }
  .contact__open {
    margin-top: 1.4rem;
  }

  .contact-dialog {
    width: min(28rem, calc(100vw - 2.5rem));
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    color: var(--text);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: 0 30px 70px -30px rgba(58, 42, 24, 0.45);
  }
  .contact-dialog::backdrop {
    background: color-mix(in srgb, var(--text) 35%, transparent);
    backdrop-filter: blur(3px);
  }
  .contact-dialog__close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.35rem;
    line-height: 1;
  }
  .contact-dialog__close:hover {
    color: var(--text);
  }
  .contact-dialog__title {
    font-family: var(--display);
    font-size: 1.7rem;
    margin-bottom: 0.4rem;
  }
  .contact-dialog__intro {
    color: var(--text-dim);
    font-size: 0.92rem;
    margin-bottom: 1.4rem;
  }

  .form {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  label {
    display: grid;
    gap: 0.4rem;
    width: 100%;
  }
  label span {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  input,
  textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--sans);
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    transition: border-color 0.15s ease;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  textarea {
    resize: vertical;
  }
  .form__status {
    font-size: 0.92rem;
  }
  .form__status--ok {
    color: var(--accent);
  }
  .form__status--err {
    color: var(--text-dim);
  }
  .form__status--err a {
    color: var(--accent);
  }
</style>
