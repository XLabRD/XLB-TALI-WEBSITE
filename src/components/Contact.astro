---
// Landing-page contact section: a button that opens the form in a modal.
// The form itself lives in ContactForm.astro so /support/ can render the same
// one inline (DEC-34).
import ContactForm from './ContactForm.astro';

interface Props {
  copy: Record<string, any>;
  ui: Record<string, string>;
  settings: { contactEmail: string; formEndpoint: string };
  /** Support link shown under the intro; omitted when there is nowhere to go. */
  supportHref?: string;
  supportLabel?: string;
}
const { copy, ui, settings, supportHref, supportLabel } = Astro.props;
---

<section class="section" id="contact">
  <div class="wrap contact">
    <div class="section__head contact__head">
      <p class="kicker">{copy.contactKicker}</p>
      <h2 class="section__title">{copy.contactTitle}</h2>
      <p class="contact__intro">{copy.contactIntro}</p>
      <button class="btn contact__open" type="button">{ui.formSend}</button>
      {
        supportHref && supportLabel && (
          <p class="contact__support">
            <a href={supportHref}>{supportLabel}</a>
          </p>
        )
      }
      <noscript>
        <p class="contact__intro">
          <a href={`mailto:${settings.contactEmail}`}>{ui.formMailto}</a>
        </p>
      </noscript>
    </div>
  </div>
</section>

<dialog class="contact-dialog" aria-labelledby="contact-dialog-title">
  <button class="contact-dialog__close" type="button" aria-label="Close">✕</button>
  <h2 class="contact-dialog__title" id="contact-dialog-title">{copy.contactTitle}</h2>
  <p class="contact-dialog__intro">{copy.contactIntro}</p>
  <ContactForm ui={ui} settings={settings} />
</dialog>

<script>
  const dialog = document.querySelector('.contact-dialog') as HTMLDialogElement;

  const open = () => {
    dialog.showModal();
    // ContactForm listens for this and only then fetches the captcha script.
    document.dispatchEvent(new CustomEvent('contact-form:shown'));
  };

  // any link pointing at #contact opens the dialog instead of scrolling
  document.querySelectorAll<HTMLAnchorElement>('a[href="#contact"]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      open();
    })
  );
  document.querySelector('.contact__open')?.addEventListener('click', open);
  dialog.querySelector('.contact-dialog__close')?.addEventListener('click', () => dialog.close());
  // click on the backdrop closes — coordinate check so clicks on the
  // dialog's own padding don't count as backdrop (they share the target)
  dialog.addEventListener('click', (e) => {
    const r = dialog.getBoundingClientRect();
    const inside =
      e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
    if (e.target === dialog && !inside) dialog.close();
  });
</script>

<style>
  .contact {
    display: grid;
  }
  .contact__head {
    margin-bottom: 0;
  }
  .contact__intro {
    color: var(--text-dim);
  }
  .contact__open {
    margin-top: 1.4rem;
  }
  .contact__support {
    font-size: 0.92rem;
  }
  .contact__support a {
    color: var(--accent);
  }

  .contact-dialog {
    width: min(28rem, calc(100vw - 2.5rem));
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    color: var(--text);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: 0 30px 70px -30px rgba(58, 42, 24, 0.45);
  }
  .contact-dialog::backdrop {
    background: color-mix(in srgb, var(--text) 35%, transparent);
    backdrop-filter: blur(3px);
  }
  .contact-dialog__close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 1rem;
    cursor: pointer;
    padding: 0.35rem;
    line-height: 1;
  }
  .contact-dialog__close:hover {
    color: var(--text);
  }
  .contact-dialog__title {
    font-family: var(--display);
    font-size: 1.7rem;
    margin-bottom: 0.4rem;
  }
  .contact-dialog__intro {
    color: var(--text-dim);
    font-size: 0.92rem;
    margin-bottom: 1.4rem;
  }
</style>
